# Copy to .env.deploy (gitignored). Used by `make deploy` and `make seed-prod` on YOUR machine.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
# Optional: a specific SSH key and a different directory on the VM.
# DEPLOY_KEY=/Users/you/.ssh/hospital_deploy
# DEPLOY_DIR=hospital-twin
DOMAIN=example.com
# The Tiger Cloud primary connection string, used only by `make seed-prod` to load patients from your machine.
# Put the whole value in single quotes; the password goes between "tsdbadmin:" and "@".
PROD_DATABASE_URL='postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require'

# .env.prod (also gitignored) is copied to the VM as its .env on every `make deploy`:
#   DATABASE_URL='<the same Tiger Cloud string>'
#   DOMAIN=example.com
#   GEMINI_API_KEY=...
#   GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash
#   AGENT_LLM_MIN_INTERVAL_S=300
