# Copy to .env (make setup does this). Never commit .env. All values here are dummies.

# TimescaleDB. Local: the Docker database from `make db`. Production: the Tiger Cloud connection string.
DATABASE_URL=postgresql://twin:twin@localhost:5433/twin

# Integration-test database server (infra/docker-compose.test.yml). Tests create their own databases in it.
TEST_DATABASE_URL=postgresql://twin:twin@localhost:5434/twin_test

# Backend API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Simulation (PROMPT.md §5). The seed fixes all randomness. Each backend start begins a new run: the
# previous run's rows are removed (SIM_RESET_ON_START) and the warm-up period is simulated first so the
# hospitals are busy when the visible run starts at 2026-11-14 08:00 Phoenix time.
SIM_SEED=20261114
SIM_WARMUP_HOURS=72
SIM_SPEED=1
SIM_AUTOSTART=true
SIM_RESET_ON_START=true
SIM_DEBUG=false
# Score patients and forecast demand with the trained models in models/ (make train).
ML_ENABLED=true
# The operations agent (PROMPT.md §9). It uses Gemini when GEMINI_API_KEY and GEMINI_MODEL are set, and
# the rules engine otherwise or when Gemini fails. AGENT_LLM_MIN_INTERVAL_S limits Gemini calls per hospital.
AGENT_ENABLED=true
AGENT_LLM_MIN_INTERVAL_S=20

# Gemini operations agent (needed from CP6). Leave empty to use the rules engine.
GEMINI_API_KEY=
# One model name or a comma-separated list tried in order, for example:
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash
GEMINI_MODEL=
# Optional local model used when Gemini fails or hangs. Ollama needs no key: run `ollama serve`, `ollama pull qwen2.5:1.5b`,
# then set OLLAMA_URL=http://127.0.0.1:11434 and OLLAMA_MODEL=qwen2.5:1.5b. Leave both empty to turn it off.
OLLAMA_URL=
OLLAMA_MODEL=

# Synthea patient generation (make seed). SYNTHEA_JAVA: path of a Java 17 binary; empty = find it.
SYNTHEA_JAVA=
SYNTHEA_POPULATION=3000
SYNTHEA_SEED=20261114
